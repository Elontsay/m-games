# Copy to .env and fill in. Never commit .env.

# Flask session signing key. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application").
# Authorized redirect URI must be exactly:  http://127.0.0.1:5000/auth/callback   (plus your production URL later)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated emails that get the admin hacks panel.
ADMIN_EMAILS=

# Set to 1 to allow /dev-login (name-only sign-in) while Google isn't configured. Local development only.
DEV_LOGIN=1

# Anthropic API key, for the AI review that explains a question you got wrong.
# Get one at https://console.anthropic.com. Leave it blank and the game simply
# hides the "Explain it" button instead of offering something that can't work.
ANTHROPIC_API_KEY=
